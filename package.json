{
  "name": "gate-force",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "pnpm --filter @gate-force/web dev",
    "dev:mobile": "pnpm --filter @gate-force/mobile start",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.0.6",
    "typescript": "^5.4.5"
  }
}
